
# Superuser for PocketBase Admin UI (http://localhost:8090/_/)
PB_ADMIN_EMAIL=admin@inventory.local
PB_ADMIN_PASSWORD=Admin123456!

# Published app port (PocketBase serves UI + API)
APP_PORT=8090

# Auto-import pb_schema.json on first launch (default true)
PB_AUTO_IMPORT_SCHEMA=true
# Optional demo data after schema import
PB_AUTO_SEED=false

# Create an initial admin user (default true)
APP_ADMIN_USER_CREATE=true
APP_USER_EMAIL=admin@company.com
APP_USER_PASSWORD=Admin123456!

# Force re-import even if collections already exist
PB_FORCE_SCHEMA_IMPORT=false

# Frontend build-time API URL.
# Leave empty for same-origin (recommended — UI is served from pb_public).
VITE_POCKETBASE_URL=
